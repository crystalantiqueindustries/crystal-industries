<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crystal Industries | Premium Antique Brass & Metallic Pipe Supplier</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-main: #141210;
            --bg-card: #1f1c18;
            --accent-brass: #d4af37;
            --accent-copper: #b87333;
            --text-light: #f4efea;
            --text-muted: #a39b8e;
            --border-color: #38322a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-light);
            line-height: 1.6;
        }

        h1, h2, h3, .brand-logo {
            font-family: 'Cinzel', serif;
        }

        /* Header / Navigation */
        header {
            background-color: rgba(20, 18, 16, 0.95);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
            padding: 1rem 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-logo {
            font-size: 1.5rem;
            color: var(--accent-brass);
            text-decoration: none;
            letter-spacing: 1px;
        }

        nav a {
            color: var(--text-light);
            text-decoration: none;
            margin-left: 1.5rem;
            font-size: 0.95rem;
            transition: color 0.3s;
        }

        nav a:hover {
            color: var(--accent-brass);
        }

        /* Hero Section */
        .hero {
            padding: 5rem 5% 4rem;
            text-align: center;
            background: radial-gradient(circle at center, #2a251e 0%, var(--bg-main) 70%);
            border-bottom: 1px solid var(--border-color);
        }

        .hero h1 {
            font-size: 2.8rem;
            color: var(--accent-brass);
            margin-bottom: 1rem;
        }

        .hero p {
            font-size: 1.2rem;
            color: var(--text-muted);
            max-width: 700px;
            margin: 0 auto 2rem;
        }

        .cta-button {
            display: inline-block;
            background: linear-gradient(135deg, var(--accent-brass), var(--accent-copper));
            color: #141210;
            font-weight: 700;
            padding: 0.85rem 2rem;
            border-radius: 4px;
            text-decoration: none;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .cta-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
        }

        /* Gallery Section */
        .section-title {
            text-align: center;
            font-size: 2rem;
            color: var(--accent-brass);
            margin-bottom: 0.5rem;
        }

        .section-subtitle {
            text-align: center;
            color: var(--text-muted);
            margin-bottom: 3rem;
        }

        .gallery-section {
            padding: 4rem 5%;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }

        .gallery-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            overflow: hidden;
            transition: border-color 0.3s;
        }

        .gallery-card:hover {
            border-color: var(--accent-brass);
        }

        .card-image-placeholder {
            width: 100%;
            height: 220px;
            background-color: #2b2620;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            font-size: 0.9rem;
            border-bottom: 1px solid var(--border-color);
        }

        .card-image-placeholder img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .card-content {
            padding: 1.5rem;
        }

        .card-content h3 {
            color: var(--accent-brass);
            margin-bottom: 0.5rem;
        }

        .card-content p {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* Features / Why Choose Us */
        .features-section {
            padding: 4rem 5%;
            background-color: var(--bg-card);
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .feature-box {
            padding: 1.5rem;
            border-left: 3px solid var(--accent-brass);
            background-color: rgba(255, 255, 255, 0.02);
        }

        .feature-box h4 {
            color: var(--text-light);
            margin-bottom: 0.5rem;
        }

        .feature-box p {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* Contact Section */
        .contact-section {
            padding: 4rem 5%;
            text-align: center;
        }

        .contact-cards {
            display: flex;
            justify-content: center;
            gap: 2rem;
            flex-wrap: wrap;
            margin-top: 2rem;
        }

        .contact-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 2rem;
            border-radius: 8px;
            min-width: 280px;
            flex: 1;
            max-width: 400px;
        }

        .contact-card h3 {
            color: var(--accent-brass);
            margin-bottom: 0.5rem;
        }

        .contact-card a {
            color: var(--text-light);
            text-decoration: none;
            font-size: 1.1rem;
            font-weight: 600;
        }

        .contact-card a:hover {
            color: var(--accent-copper);
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 2rem;
            border-top: 1px solid var(--border-color);
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        @media (max-width: 768px) {
            .hero h1 { font-size: 2rem; }
            header { flex-direction: column; gap: 1rem; }
            nav a { margin: 0 0.75rem; }
        }
    </style>
</head>
<body>

